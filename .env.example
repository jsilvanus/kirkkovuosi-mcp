PORT=5998
HOST=0.0.0.0
MCP_PUBLIC_URL=https://mcp.example.com
# base64-encoded random secret, at least 32 bytes
JWT_SECRET=
# Default local OAuth account created on first start.
MCP_DEFAULT_USER_EMAIL=demo@example.com
MCP_DEFAULT_USER_PASSWORD=
STORAGE_PATH=./data/app.sqlite
MCP_DEFAULT_USER_ID=demo-user

# --- Optional: single sign-on through an OIDC provider (e.g. authentik) ---
# Unset/empty = off: no SSO button, no /oidc routes. Redirect URI to register at the IdP: <MCP_PUBLIC_URL>/oidc/callback
# Issuer exactly as the IdP publishes it (authentik: https://auth.example.org/application/o/<slug>/, keep the trailing slash)
OIDC_ISSUER=
# Required when OIDC_ISSUER is set
OIDC_CLIENT_ID=
# Optional: set = confidential client (client_secret_basic), unset = public client. PKCE is always used.
OIDC_CLIENT_SECRET=
# Default: openid email profile (must contain openid)
OIDC_SCOPES=
# Default: Sign in with single sign-on
OIDC_BUTTON_LABEL=
# true = create a local user for an IdP user who has none (the IdP's application policy decides who may sign in). Default false.
OIDC_CREATE_USERS=false
# true = link to an existing local user by email even when the IdP does not say email_verified=true. Default false.
OIDC_TRUST_EMAIL=false
